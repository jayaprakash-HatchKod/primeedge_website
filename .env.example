# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Prisma) ---
# Project Settings -> Database -> Connection string
# Use the pooled connection (port 6543, pgbouncer) for DATABASE_URL and the
# direct connection (port 5432) for DIRECT_URL (used for migrations).
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Razorpay ---
# Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Dev-only bypass that skips the real Razorpay checkout and payment
# verification entirely. Leave unset (or "false") everywhere except local
# testing before real keys exist — MUST be unset/false in production, or
# enrollments will be recorded as "paid" with no money collected.
NEXT_PUBLIC_PAYMENTS_MOCK_MODE=false

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Institute contact (shown on success page & footer) ---
NEXT_PUBLIC_INSTITUTE_EMAIL=support@primeedge.in
NEXT_PUBLIC_INSTITUTE_PHONE=+91 90000 00000

# Contact email shown on the Final Year Projects page.
NEXT_PUBLIC_PROJECT_SUPPORT_EMAIL=projectsupport@yourdomain.com

# --- Projects (final-year project leads) ---
# Telegram group/channel invite link shown to a student after they submit
# the "Get This Project" lead form.
TELEGRAM_PROJECTS_LINK=https://t.me/your-group-invite-link

# Telegram group invite link for enrolled students (course batch group),
# included in the enrollment confirmation email.
TELEGRAM_STUDENTS_LINK=https://t.me/your-students-group-invite-link

# --- Resend (transactional email) ---
# https://resend.com/api-keys — needed to send enrollment confirmation emails.
# Sandbox sender (onboarding@resend.dev) only delivers to your own verified
# email until you verify a sending domain in Resend.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=PrimeEdge Software Institute <no-reply@yourdomain.com>
